<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beat Lab: Interactive Drum Machine & Guide</title>
    <style>
        :root {
            --bg-color: #1a1a24;
            --panel-bg: #242436;
            --accent-color: #00ffcc;
            --accent-glow: rgba(0, 255, 204, 0.4);
            --active-step: #ff0055;
            --active-glow: rgba(255, 0, 85, 0.5);
            --text-main: #f0f0f5;
            --text-muted: #a0a0b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            background-color: var(--panel-bg);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        header {
            text-align: center;
            margin-bottom: 24px;
        }

        header h1 {
            color: var(--accent-color);
            letter-spacing: 2px;
            margin-bottom: 6px;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Controls Section */
        .controls {
            display: flex;
            gap: 20px;
            align-items: center;
            justify-content: space-between;
            background: rgba(0, 0, 0, 0.2);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .control-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        button {
            background: var(--accent-color);
            color: var(--bg-color);
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        button:hover {
            box-shadow: 0 0 12px var(--accent-glow);
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        label {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        input[type="range"] {
            accent-color: var(--accent-color);
            cursor: pointer;
        }

        select {
            background: var(--bg-color);
            color: var(--text-main);
            border: 1px solid var(--text-muted);
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        /* Grid Layout */
        .sequencer-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 24px;
            overflow-x: auto;
        }

        .track {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .track-label {
            width: 80px;
            font-weight: bold;
            font-size: 0.85rem;
            color: var(--accent-color);
            text-transform: uppercase;
        }

        .steps {
            display: flex;
            gap: 6px;
            flex-grow: 1;
        }

        .step {
            flex: 1;
            aspect-ratio: 1;
            min-width: 24px;
            max-width: 40px;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.1s;
        }

        /* Group steps into beats visually (every 4 steps) */
        .step:nth-child(4n + 1) {
            border-left: 2px solid var(--text-muted);
        }

        .step.active {
            background-color: var(--accent-color);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .step.playing {
            border-color: #fff;
            transform: scale(1.05);
        }

        .step.active.playing {
            background-color: var(--active-step);
            box-shadow: 0 0 12px var(--active-glow);
        }

        /* Educational Card */
        .edu-card {
            background: rgba(0, 0, 0, 0.3);
            border-left: 4px solid var(--accent-color);
            padding: 16px;
            border-radius: 0 8px 8px 0;
        }

        .edu-card h3 {
            font-size: 1.1rem;
            margin-bottom: 6px;
            color: var(--accent-color);
        }

        .edu-card p {
            font-size: 0.95rem;
            line-height: 1.5;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>BEAT LAB</h1>
        <p>An interactive 16-step sequencer and rhythm guide</p>
    </header>

    <div class="controls">
        <button id="playBtn">Play</button>

        <div class="control-group">
            <label for="tempo">BPM: <span id="bpmVal">120</span></label>
            <input type="range" id="tempo" min="60" max="180" value="120">
        </div>

        <div class="control-group">
            <label for="preset">Preset Groove:</label>
            <select id="preset">
                <option value="clear">Clear All</option>
                <option value="fourFloor" selected>Four-on-the-Floor (House)</option>
                <option value="rock">Basic Rock Beat</option>
                <option value="hiphop">Boom Bap (Hip-Hop)</option>
            </select>
        </div>
    </div>

    <div class="sequencer-grid" id="grid">
        </div>

    <div class="edu-card">
        <h3 id="eduTitle">Learning Center</h3>
        <p id="eduText">Click grid squares to toggle sounds on specific beats, or load a preset above to understand standard rhythmic structures.</p>
    </div>
</div>

<script>
    // Audio Context Setup using Web Audio API (Synthesized drum sounds)
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;

    const tracks = [
        { name: 'Hi-Hat', sound: playHiHat },
        { name: 'Snare', sound: playSnare },
        { name: 'Kick', sound: playKick }
    ];

    const totalSteps = 16;
    let gridState = Array(tracks.length).fill(null).map(() => Array(totalSteps).fill(false));
    let isPlaying = false;
    let currentStep = 0;
    let tempo = 120;
    let timerId = null;

    // Educational Information for Presets
    const eduContent = {
        clear: {
            title: "Blank Canvas",
            text: "Each row represents a drum instrument, and each column represents a 16th-note time step. 4 steps equal 1 full beat in 4/4 time."
        },
        fourFloor: {
            title: "Four-on-the-Floor Groove",
            text: "Common in Dance & House music. The Kick hits steadily on every main beat (steps 1, 5, 9, 13), while the Hi-Hat plays on the 'off-beats' in between."
        },
        rock: {
            title: "Standard Rock Pattern",
            text: "Anchored by a driving Hi-Hat on every 8th note. The Kick drives beats 1 and 3, while the Snare provides the 'backbeat' on beats 2 and 4."
        },
        hiphop: {
            title: "Classic Hip-Hop (Boom Bap)",
            text: "Features a strong Snare backbeat on 5 and 13, with a syncopated (slightly off-grid) Kick pattern that gives the track its characteristic bounce."
        }
    };

    // Build Sequencer UI Grid
    const gridEl = document.getElementById('grid');

    tracks.forEach((track, trackIdx) => {
        const trackRow = document.createElement('div');
        trackRow.className = 'track';

        const label = document.createElement('div');
        label.className = 'track-label';
        label.innerText = track.name;
        trackRow.appendChild(label);

        const stepsContainer = document.createElement('div');
        stepsContainer.className = 'steps';

        for (let stepIdx = 0; stepIdx < totalSteps; stepIdx++) {
            const stepBtn = document.createElement('div');
            stepBtn.className = 'step';
            stepBtn.dataset.track = trackIdx;
            stepBtn.dataset.step = stepIdx;

            stepBtn.addEventListener('click', () => {
                gridState[trackIdx][stepIdx] = !gridState[trackIdx][stepIdx];
                stepBtn.classList.toggle('active');
            });

            stepsContainer.appendChild(stepBtn);
        }

        trackRow.appendChild(stepsContainer);
        gridEl.appendChild(trackRow);
    });

    // Synthesized Drum Sounds (No external audio files needed)
    function playKick(time) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.frequency.setValueAtTime(150, time);
        osc.frequency.exponentialRampToValueAtTime(0.01, time + 0.5);
        gain.gain.setValueAtTime(1, time);
        gain.gain.exponentialRampToValueAtTime(0.01, time + 0.5);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(time);
        osc.stop(time + 0.5);
    }

    function playSnare(time) {
        // Noise buffer for the snare snap
        const bufferSize = audioCtx.sampleRate * 0.2;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            output[i] = Math.random() * 2 - 1;
        }
        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;

        const noiseFilter = audioCtx.createBiquadFilter();
        noiseFilter.type = 'highpass';
        noiseFilter.frequency.value = 1000;
        noise.connect(noiseFilter);

        const noiseEnvelope = audioCtx.createGain();
        noiseFilter.connect(noiseEnvelope);
        noiseEnvelope.gain.setValueAtTime(1, time);
        noiseEnvelope.gain.exponentialRampToValueAtTime(0.01, time + 0.2);
        noiseEnvelope.connect(audioCtx.destination);

        // Body tone
        const osc = audioCtx.createOscillator();
        const oscEnvelope = audioCtx.createGain();
        osc.frequency.setValueAtTime(180, time);
        osc.frequency.exponentialRampToValueAtTime(0.01, time + 0.1);
        oscEnvelope.gain.setValueAtTime(0.7, time);
        oscEnvelope.gain.exponentialRampToValueAtTime(0.01, time + 0.1);
        osc.connect(oscEnvelope);
        oscEnvelope.connect(audioCtx.destination);

        noise.start(time);
        osc.start(time);
        noise.stop(time + 0.2);
        osc.stop(time + 0.1);
    }

    function playHiHat(time) {
        const bufferSize = audioCtx.sampleRate * 0.05;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            output[i] = Math.random() * 2 - 1;
        }
        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.value = 7000;

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.6, time);
        gain.gain.exponentialRampToValueAtTime(0.01, time + 0.05);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        noise.start(time);
        noise.stop(time + 0.05);
    }

    // Loop Clock
    function tick() {
        const now = audioCtx.currentTime;

        // Visual highlighting of current step
        const prevStep = (currentStep + totalSteps - 1) % totalSteps;
        document.querySelectorAll(`.step[data-step="${prevStep}"]`).forEach(el => el.classList.remove('playing'));
        document.querySelectorAll(`.step[data-step="${currentStep}"]`).forEach(el => el.classList.add('playing'));

        // Play sounds for current step
        tracks.forEach((track, trackIdx) => {
            if (gridState[trackIdx][currentStep]) {
                track.sound(now);
            }
        });

        currentStep = (currentStep + 1) % totalSteps;

        // Calculate step interval in milliseconds from BPM (16th notes)
        const stepInterval = (60 / tempo / 4) * 1000;
        timerId = setTimeout(tick, stepInterval);
    }

    // Preset Manager
    const presets = {
        clear: [],
        fourFloor: [
            [2, 6, 10, 14],            // Hi-Hat on off-beats
            [],                        // Snare
            [0, 4, 8, 12]              // Kick every beat
        ],
        rock: [
            [0, 2, 4, 6, 8, 10, 12, 14], // Hi-Hat 8th notes
            [4, 12],                     // Snare on 2 and 4
            [0, 8, 10]                   // Kick on 1, 3, and 3-and
        ],
        hiphop: [
            [0, 2, 4, 6, 8, 10, 12, 14], // Hi-Hat 8th notes
            [4, 12],                     // Snare backbeat
            [0, 3, 8, 11]                // Syncopated Kick
        ]
    };

    function loadPreset(name) {
        // Reset grid
        gridState = Array(tracks.length).fill(null).map(() => Array(totalSteps).fill(false));
        
        if (presets[name]) {
            presets[name].forEach((stepArray, trackIdx) => {
                stepArray.forEach(stepIdx => {
                    gridState[trackIdx][stepIdx] = true;
                });
            });
        }

        // Update UI
        document.querySelectorAll('.step').forEach(stepEl => {
            const t = parseInt(stepEl.dataset.track);
            const s = parseInt(stepEl.dataset.step);
            stepEl.classList.toggle('active', gridState[t][s]);
        });

        // Update Edu Text
        document.getElementById('eduTitle').innerText = eduContent[name].title;
        document.getElementById('eduText').innerText = eduContent[name].text;
    }

    // Event Listeners
    document.getElementById('playBtn').addEventListener('click', (e) => {
        if (!audioCtx) {
            audioCtx = new AudioContext(); // Context must be created/resumed on user gesture
        }

        if (isPlaying) {
            clearTimeout(timerId);
            isPlaying = false;
            e.target.innerText = 'Play';
            document.querySelectorAll('.step').forEach(el => el.classList.remove('playing'));
        } else {
            isPlaying = true;
            e.target.innerText = 'Pause';
            currentStep = 0;
            tick();
        }
    });

    document.getElementById('tempo').addEventListener('input', (e) => {
        tempo = e.target.value;
        document.getElementById('bpmVal').innerText = tempo;
    });

    document.getElementById('preset').addEventListener('change', (e) => {
        loadPreset(e.target.value);
    });

    // Load default preset on initialization
    loadPreset('fourFloor');
</script>
</body>
</html>
